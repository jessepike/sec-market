{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "verify:edition": "tsx scripts/verify-edition.ts",
    "verify:panel": "tsx scripts/verify-panel.ts",
    "verify:integrity": "tsx --tsconfig tsconfig.app.json scripts/verify-integrity.ts",
    "verify:issue": "tsx --tsconfig tsconfig.app.json scripts/verify-issue.ts",
    "verify:prints": "tsx --tsconfig tsconfig.app.json scripts/verify-prints.ts",
    "verify:tracker": "tsx --tsconfig tsconfig.app.json scripts/verify-tracker.ts",
    "verify:dist": "tsx --tsconfig tsconfig.app.json scripts/verify-dist.ts",
    "refresh:edgar": "tsx --tsconfig tsconfig.app.json scripts/edgar-refresh.ts",
    "refresh:filing-events": "tsx --tsconfig tsconfig.app.json scripts/filing-events.ts",
    "check:links": "tsx --tsconfig tsconfig.app.json scripts/check-links.ts",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "tsx scripts/prerender.ts",
    "seo": "tsx scripts/generate-seo.ts",
    "build:feed": "tsx --tsconfig tsconfig.app.json scripts/generate-feed.ts",
    "build": "node scripts/app-release.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e": "node scripts/ensure-test-browser.mjs && node scripts/run-browser-tests.mjs",
    "test:data": "tsx --tsconfig tsconfig.app.json --test tests/landscape-data.test.ts tests/issue-data.test.ts tests/dist-fixtures.test.ts tests/html-escape.test.ts tests/corrections-data.test.ts tests/print-checks.test.ts tests/reconfirmations.test.ts tests/platform-pressure.test.ts tests/run-status.test.ts tests/edgar-logic.test.ts tests/tracker-data.test.ts tests/tracker-presentation.test.ts tests/claim-gate.test.mjs tests/certified-tier.test.mjs",
    "test": "npm run lint && npm run test:data && npm run build && npm run test:e2e",
    "verify:app-release": "node scripts/app-release.mjs --verify",
    "certify:sec": "tsx --tsconfig tsconfig.app.json scripts/certify-sec.ts",
    "certify:gate": "tsx --tsconfig tsconfig.app.json scripts/certify-gate.ts",
    "build:certified": "npm run verify:edition && npm run verify:panel && npm run verify:integrity && npm run verify:issue && npm run verify:prints && npm run verify:tracker && tsc -b && npm run build:client && npm run build:server && npm run prerender && npm run seo && npm run build:feed && npm run verify:dist"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
