{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] || ( [ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . )",
  "crons": [
    {
      "path": "/api/dispatch",
      "schedule": "17 5 * * *"
    },
    {
      "path": "/api/watchdog",
      "schedule": "41 */6 * * *"
    }
  ]
}
