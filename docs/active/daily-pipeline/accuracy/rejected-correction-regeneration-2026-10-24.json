    "pythonSource": "import copy,json,sys\nfrom pathlib import Path\nsys.path.insert(0,'web/scripts/pipeline')\nfrom contracts import canonical,digest\nfrom corrections import group_review_policy,load_policy\nroot=Path.cwd();temp=Path('/tmp/smp-rejected-correction-repair-20261024')\nrequest_path=root/'contracts/factual-corrections.json';stamp_path=root/'web/src/data/tracker/factualCorrectionPolicy.json'\nraw=request_path.read_bytes()\nassert digest(raw)=='bb239e6e8256b9abc797d0ac89e940179f597e20ba654d2bb0513ff26e5b5c52'\nold=json.loads(raw);market=json.loads((root/'contracts/market.json').read_bytes());old_stamp=json.loads(stamp_path.read_bytes())\nload_policy(root,market)\nchanges={\n'FC-20261023-checkpoint-sase':{\n'reasonCode':'incorrect-issuance-period',\n'noteTemplate':'Correction, {date}. The Check Point debt entry dated 30 July 2026 incorrectly described a new Q2 offering. The offering closed on 8 December 2025. The Q2 cash comparison used proceeds after issuance costs and capped-call purchases. The July issuance entry is withdrawn.'},\n'FC-20261023-zscaler':{\n'noteTemplate':'Correction, {date}. The Zscaler entry dated 24 September 2026 included a board resignation with an incorrect effective date. Raj Judge resigned from the board effective 15 April 2026. That clause is removed; the September entry retains the Chief Revenue Officer transition.'}}\nnew=copy.deepcopy(old)\nfor group in new['groups']:\n for key,value in changes.get(group['id'],{}).items():\n  token=json.dumps(group[key]).encode();replacement=json.dumps(value).encode()\n  assert raw.count(token)==1\n  raw=raw.replace(token,replacement)\n  group[key]=value\nassert json.loads(raw)==new\nnew_stamp=copy.deepcopy(old_stamp)\nnew_stamp['policySha256']=digest({'marketSha256':digest(market),'requestsSha256':digest(new),'baselineSha256':new['baseline']['sha256']})\nnew_stamp['reviewPolicySha256ByGroup']={g['id']:group_review_policy(g,market,new['baseline']['sha256']) for g in new['groups']}\nassert len(new['groups'])==6\nfor before,after in zip(old['groups'],new['groups']):\n assert before['targets']==after['targets'] and before['sources']==after['sources']\n if before['id'] not in changes:\n  assert canonical(before)==canonical(after)\n  assert old_stamp['reviewPolicySha256ByGroup'][before['id']]==new_stamp['reviewPolicySha256ByGroup'][before['id']]\nrequest_path.write_bytes(raw)\nstamp_path.write_text(json.dumps(new_stamp,indent=2)+'\\n')\nload_policy(root,market)\nprint('global',new_stamp['policySha256'])\nfor group in new['groups']:\n print(group['id'],'candidate',digest(group),'review',new_stamp['reviewPolicySha256ByGroup'][group['id']])\nprint('All six target/source arrays unchanged; four accepted groups and policies exact.')\n",
