#!/usr/bin/env bash
# Installs this repo's git hooks into .git/hooks/.
#
# By copy, not by core.hooksPath: a hook that lives on a branch disappears when
# you check out a different branch, and the branch it guards is exactly the one
# you switch to in order to push. .git/hooks/ is branch-independent.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"
hooks_dir="$(git rev-parse --git-path hooks)"
mkdir -p "$hooks_dir"
for hook in .githooks/*; do
  name="$(basename "$hook")"
  [ "$name" = "install" ] && continue
  install -m 755 "$hook" "$hooks_dir/$name"
  echo "installed $hooks_dir/$name"
done
