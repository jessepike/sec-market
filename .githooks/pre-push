#!/usr/bin/env bash
# Refuses a direct push to main. Production moves only by promotion from preview (D-50).
#
# On 2026-08-19 the D-48 landscape reached production by an ordinary push while the
# decision record said "do not merge" and the owner believed nothing had been promoted
# (D-49). A rule that lives only in a document is not a control. This is the control.
#
# Install per clone with:  ./.githooks/install
# Deliberate promotion:    PROMOTE=1 git push origin main
#
# Installed by COPY into .git/hooks/, deliberately, not via core.hooksPath.
# core.hooksPath pointing at a tracked directory looks tidier and is wrong here:
# the guard then only exists on branches that carry the directory, so checking
# out main -- the one branch it guards -- removes it. Verified the hard way.

set -euo pipefail

while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  # Deleting a branch pushes the all-zero sha. Let that through.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac

  if [ "${PROMOTE:-}" = "1" ]; then
    root="$(git rev-parse --show-toplevel)"
    if [ "$(git rev-parse HEAD)" != "$local_sha" ] || [ -n "$(git status --porcelain --untracked-files=normal)" ]; then
      echo 'pre-push refused: production requires the exact clean checked-out commit.' >&2
      exit 1
    fi
    if [ ! -f "$root/web/scripts/app-release.mjs" ]; then
      echo 'pre-push refused: this commit lacks the required complete-refresh publication guard.' >&2
      exit 1
    fi
    node "$root/web/scripts/app-release.mjs" --verify || exit 1
    echo "pre-push: explicit promotion and complete-refresh guard passed." >&2
    continue
  fi

  cat >&2 <<'MSG'

  pre-push refused: main is production.

  main serves https://securitymarketpulse.com and moves only by promoting
  preview after the owner says yes (D-50).

    git checkout main
    git merge --ff-only preview
    PROMOTE=1 git push origin main

  If you are not promoting on an explicit owner yes, you are on the wrong
  branch. Push to preview instead.

MSG
  exit 1
done

exit 0
