        yearContainer: '#_ctrl0_ctl54_selectEvergreenNewsYear',
        yearTemplate: '<option value="{{value}}">{{ year }}</option>',
        noYearsMessage: '<option value="-">-</option>',
        allYearsText: 'All',

        itemNotFoundMessage: $tudio('#_ctrl0_ctl54_divModuleContainertplEvergreenNewsNoItems').html(),
        loadingMessage: $tudio("#_ctrl0_ctl54_divModuleContainertplEvergreenNewsLoading").html(),

        itemContainer: '#_ctrl0_ctl54_divNewsItemsContainer',
        itemTemplate: $tudio('#_ctrl0_ctl54_divModuleContainertplListEvergreenNews').html(),

        loadShortBody: 0,
        shortBodyLength: 240,

        itemsComplete: function (e) {
            if ($tudio(e.target).find('#_ctrl0_ctl54_divModuleContainerdivEvergreenNewsStatusAnnouncement').length) {
                announceSrOnlyNewsCount(e);
            }
            if ($tudio(e.target).find('#_ctrl0_ctl54_navNewsPager').length) {
                $tudio(e.target).find('#_ctrl0_ctl54_navNewsPager').q4Pager({
                    content: $tudio(e.target).find('.evergreen-news-item'),
                    perPage: 0,
                    showPrevNext: false,
                    afterChange: function (e) {
                        announceSrOnlyNewsCount(e);
                    }
                });
            }
        },

        complete: function (e) {
            if ($tudio('#_ctrl0_ctl54_divEvergreenNewsFilter').length) {
                $tudio(e.target).find('#_ctrl0_ctl54_divModuleContainerdivEvergreenNewsStatusAnnouncement').remove();
                announceSrOnlyNewsCount(e);
            }

            const containerClassName = ".evergreen-container.evergreen-container--outer.evergreen-container--news";

            if (0 == 2) {
                function checkContainerHeight() {
                    var windowWidth = $(window).outerWidth();
                    var bgContainer = $tudio(e.target).find(".evergreen-news-layout-overlay-background");
                    var newsContainer = $tudio(e.target).find(containerClassName);
                    var newsContainerSpaceClass = "evergreen-container-news--overlay-space";

                    if (windowWidth <= 768 && windowWidth > 480 ) {
                        if (newsContainer.outerHeight() > bgContainer.outerHeight()) {
                            newsContainer.addClass(newsContainerSpaceClass);
                        } else {
                            newsContainer.removeClass(newsContainerSpaceClass);
                        }
                    } else {
                        newsContainer.removeClass(newsContainerSpaceClass);
                    }
                }

                checkContainerHeight();

                $(window).resize(function () {
                    checkContainerHeight();
                });

                var observer = new MutationObserver(function (mutationsList, observer) {
                    for (var mutation of mutationsList) {
                        if (mutation.type === 'childList' || mutation.type === 'subtree') {
                            checkContainerHeight();
                            break;
                        }
                    }
                });

                observer.observe($tudio(e.target).find(containerClassName)[0], { subtree: true, childList: true });
            }

            if (0 == 5) {
                function matchStyledListSizes() {
                    // Match heights of all styledlist items
                    var $items = $tudio(e.target).find('.evergreen-news-styledlist .evergreen-news-item .evergreen-news-styledlist-content');
                    if ($items.length > 1) {
                        $items.css('height', '');
                        let maxHeight = 0;
                        $items.each(function () {
                            let childrenHeight = 0;
                            $(this).children(':visible').each(function () {
                                childrenHeight += $(this).outerHeight(true);
                            });
                            const h = Math.ceil(childrenHeight + parseInt($(this).css("padding")) * 2);
                            const headerHeight = $(this).parent().find('.evergreen-news-styledlist-header').outerHeight(false);
                            if (h > maxHeight) maxHeight = Math.max(headerHeight, h);
                        });

                        $items.css('--height', maxHeight + 'px');
                    }

                    // Match headers width for desktop layout
                    if ($(window).outerWidth() <= 768) {
                        return;
                    }
                    var $items = $tudio(e.target).find('.evergreen-news-styledlist .evergreen-news-item .evergreen-news-styledlist-header');
                    if ($items.length > 1) {
                        $items.css('width', '');
                        let maxWidth = 0;
                        $items.each(function () {
                            const w = Math.ceil($(this).outerWidth());
                            if (w > maxWidth) maxWidth = w;
                        });
                        
                        $items.css('--desktopWidth', maxWidth + 'px');
                    }
                }

                matchStyledListSizes();

                $(window).resize(function () {
                    matchStyledListSizes();
                });

                var observer = new MutationObserver(function (mutationsList, observer) {
                    for (var mutation of mutationsList) {
                        if (mutation.type === 'childList' || mutation.type === 'subtree') {
                            matchStyledListSizes();
                            break;
                        }
                    }
                });

                observer.observe($tudio(e.target).find(containerClassName)[0], { subtree: true, childList: true });
            }
        }
    });

    getSrOnlyNewsCount = function () {
        var container = document.getElementById('_ctrl0_ctl54_divNewsItemsContainer');
        if (container) {
            var itemCount = container.querySelectorAll('.evergreen-news-item').length;
            var visibleItemCount = container.querySelectorAll('.evergreen-news-item:not(.js--hidden)').length;

            return visibleItemCount + ' (out of ' + itemCount + ')';
        }
        return "0";
    }

    announceSrOnlyNewsCount = function (e) {
        if (1) {
            var countText = getSrOnlyNewsCount();
            q4EvergreenHelpers.a11yAnnouncement('polite', '_ctrl0_ctl54_divModuleContainerdivEvergreenNewsStatusAnnouncement', $tudio(e.target).find('#_ctrl0_ctl54_divEvergreenNewsFilter'), function (el) {
                var year = document.getElementById('_ctrl0_ctl54_selectEvergreenNewsYear');
                $tudio(el).text('Showing ' + countText + ' news from year ' + ((year === null || year.value === '-1') ? 'All' : year.value));
            });
        }
    }
</script>
