<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.navbar_list-container').forEach(function (content) {
      content.addEventListener('mouseleave', function () {
        var parentToggle = this.closest('.w-dropdown').querySelector('.w-dropdown-toggle');
        if (parentToggle && parentToggle.classList.contains('w--open')) {
          parentToggle.click();
        }
      });
    });
  });
