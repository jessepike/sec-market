<script>
document.addEventListener("DOMContentLoaded", () => {

  const triggers = document.querySelectorAll(".nav_menu-mobile_link[data-submenu]");
  const panels = document.querySelectorAll(".nav_menu-mobile_panel");
  const contents = document.querySelectorAll(".nav_menu-mobile_content");
  const wrapper = document.querySelector(".nav_menu-mobile_panel-wrapper");
  const backButtons = document.querySelectorAll(".nav_menu-mobile_link.is-back");

  const mainPanel = panels[0]; // first panel only

  // GSAP timeline
  const tl = gsap.timeline({ paused: true });

  tl.to(wrapper, {
    x: "-100%",
    duration: 0.4,
    ease: "power1.inOut"
  }, 0);

  tl.to(mainPanel, {
    opacity: 0,
    duration: 0.25,
    ease: "power1.out"
  }, 0);

  // Open submenu
  triggers.forEach(trigger => {
    trigger.addEventListener("click", () => {
      const key = trigger.dataset.submenu;
      if (!key) return;

      contents.forEach(content => {
        content.hidden = content.dataset.submenu !== key;
      });

      tl.play();
    });
  });

  // Back buttons
  backButtons.forEach(btn => {
    btn.addEventListener("click", () => {
      tl.reverse();
    });
  });

});
</script>

<script>
  window.Webflow ||= [];
  Webflow.push(function () {
    const body = document.body;
    const menuButtons = document.querySelectorAll(".w-nav-button");

    if (!menuButtons.length) return;

    const observer = new MutationObserver(() => {
      const isAnyMenuOpen = Array.from(menuButtons).some(btn =>
        btn.classList.contains("w--open")
      );

      body.classList.toggle("no-scroll", isAnyMenuOpen);
    });

    menuButtons.forEach(btn => {
      observer.observe(btn, {
        attributes: true,
        attributeFilter: ["class"]
      });
    });
  });
</script>

