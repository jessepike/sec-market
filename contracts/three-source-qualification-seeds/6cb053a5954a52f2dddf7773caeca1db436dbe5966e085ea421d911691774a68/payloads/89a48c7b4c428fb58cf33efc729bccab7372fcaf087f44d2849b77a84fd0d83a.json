<script defer>
(function() {
  // Function to extract UTM parameters from URL
  function getUTMParam(param) {
    param = param.replace(/[\[]/, "\\[").replace(/[\]]/, "\\]");
    var regex = new RegExp("[\\?&]" + param + "=([^&#]*)");
    var results = regex.exec(location.search);
    return results === null ? "" : decodeURIComponent(results[1].replace(/\+/g, " "));
  }

  // Function to check if referrer is from LinkedIn
  function isLinkedInReferrer(referrer) {
    return referrer.includes("linkedin.");
  }

  // Function to get UTM data
  function getUTMData() {
    var params = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "gclid", "fbclid", "utm_campaign_id", "utm_ad_id", "product_code", "customer_identifier", "customer_aws_account_id"];
    var utmData = {};

    // Check sessionStorage first
    var hasStoredData = params.some(function(param) {
      return sessionStorage.getItem(param);
    });

    if (hasStoredData) {
      // Use stored values from sessionStorage
      params.forEach(function(param) {
        utmData[param] = sessionStorage.getItem(param) || "";
      });
    } else {
      // Capture new values from URL
      utmData = {
        utm_source: getUTMParam("utm_source"),
        utm_medium: getUTMParam("utm_medium"),
        utm_campaign: getUTMParam("utm_campaign"),
        utm_content: getUTMParam("utm_content"),
        utm_term: getUTMParam("utm_term"),
        gclid: getUTMParam("gclid"),
       	product_code: getUTMParam("product_code"),
        customer_identifier: getUTMParam("customer_identifier"),
        customer_aws_account_id: getUTMParam("customer_aws_account_id"),
        fbclid: getUTMParam("fbclid"),
        utm_campaign_id: getUTMParam ("utm_campaign_id"),
        utm_ad_id: getUTMParam ("utm_ad_id")
      };

      // Handle referrer-based attribution if no UTM parameters
      if (!utmData.utm_source && !utmData.utm_medium && !utmData.utm_campaign) {
        var referrer = document.referrer;
        var currentUrl = window.location.href;
        if (referrer) {
          if (referrer.includes("google.") || referrer.includes("bing.") || referrer.includes("yahoo.")) {
            utmData.utm_source = referrer.includes("google.") ? "Google" : referrer.includes("bing.") ? "Bing" : "Yahoo";
            utmData.utm_medium = "Organic Search";
            utmData.utm_campaign = "Not-Provided";
          } else if (referrer.includes("facebook.") || referrer.includes("t.co") || isLinkedInReferrer(referrer)) {
            utmData.utm_source = referrer.includes("facebook.") ? "Facebook" : referrer.includes("t.co") ? "Twitter" : "LinkedIn";
            utmData.utm_medium = "Organic Social";
            utmData.utm_campaign = "Not-Provided";
          } else {
            utmData.utm_source = referrer;
            utmData.utm_medium = "Referral";
            utmData.utm_campaign = "Not-Provided";
          }
        } else {
          utmData.utm_source = currentUrl;
          utmData.utm_medium = "Direct";
          utmData.utm_campaign = "Not-Provided";
        }
      }

      // Store in sessionStorage for the session
      for (var param in utmData) {
        if (utmData[param]) {
          sessionStorage.setItem(param, utmData[param]);
        }
      }
    }

    return utmData;
  }

  // Function to populate form fields with UTM data
  function populateFormFields(utmData) {
    var fieldMap = {
      utm_source: "UTM_Source__c",
      utm_medium: "UTM_Medium__c",
      utm_campaign: "UTM_Campaign__c",
      utm_content: "UTM_Content__c",
      utm_term: "UTM_Term__c",
      gclid: "Gclid__c",
      fbclid: "fbclid",
      utm_campaign_id: "utm_campaign_id__c",
      utm_ad_id: "utm_ad_id__c",
	  product_code: "ProductCode__c",
      customer_identifier: "CustomerIdentifier__c",
      customer_aws_account_id: "CustomerAWSAccountId__c"
    };

    document.querySelectorAll("form").forEach(function(form) {
      for (var param in fieldMap) {
        if (utmData[param]) {
          var fieldName = fieldMap[param];
          var input = form.querySelector('input[name="' + fieldName + '"]');
          if (!input) {
            input = document.createElement("input");
            input.type = "hidden";
            input.name = fieldName;
            form.appendChild(input);
          }
          input.value = utmData[param];
        }
      }
    });
  }

  // Run when page loads
  document.addEventListener("DOMContentLoaded", function() {
    var utmData = getUTMData();

    // Populate forms after a short delay to ensure forms are loaded
    setTimeout(function() {
      populateFormFields(utmData);
    }, 2000);

    // Populate forms before submission for dynamic forms
    document.querySelectorAll("form").forEach(function(form) {
      form.addEventListener("submit", function() {
        populateFormFields(utmData);
      });
    });
  });
})();
</script>

<style>
/* Base swiper nav button style */
[swiper-prev="true"],
[swiper-next="true"] {
  transition: background-color 0.2s ease;
}
</style>



<script defer>
document.addEventListener("DOMContentLoaded", () => {

  const DESKTOP_BREAKPOINT = 992;

  const GLOBAL_CONFIG = {
    speed: 1200,
    loop: false,
    spaceBetween: 20,
    observer: true,
    observeParents: true
  };

  function initSwiper(swiperEl) {
    if (swiperEl.swiper) return;

    const wrapper = swiperEl.querySelector('[swiper-wrapper="true"]');
    if (!wrapper) return;

    const slides = wrapper.querySelectorAll('[swiper-slide="true"]');
    wrapper.classList.add('swiper-wrapper');
    slides.forEach(slide => slide.classList.add('swiper-slide'));

    const parent = swiperEl.closest('[swiper-parent="true"]') || swiperEl;

    /* ---------- PEEK MODE ---------- */
    const isDesktopPeek = swiperEl.getAttribute('swiper-desktop-peek') === 'true';

    /* ---------- NAVIGATION ---------- */
    const prevEl = parent.querySelector('[swiper-prev="true"]:not([data-swiper-bound])');
    const nextEl = parent.querySelector('[swiper-next="true"]:not([data-swiper-bound])');

    let navigation;
    if (prevEl && nextEl) {
      prevEl.setAttribute('data-swiper-bound', 'true');
      nextEl.setAttribute('data-swiper-bound', 'true');
      navigation = { prevEl, nextEl };
    }

    /* ---------- PAGINATION ---------- */
    const paginationEl = parent.querySelector('[swiper-pagination="true"]:not([data-swiper-bound])');
    const bulletTemplate = paginationEl?.querySelector('[swiper-pagination-bullet="true"]');

    let pagination;
    if (paginationEl && bulletTemplate) {
      paginationEl.setAttribute('data-swiper-bound', 'true');
      pagination = {
        el: paginationEl,
        clickable: true,
        bulletClass: bulletTemplate.className,
        bulletActiveClass: 'is-active',
        renderBullet: (index, className) =>
          `<div class="${className}" data-bullet-index="${index}"></div>`
      };
    }

    /* ---------- AUTOPLAY ---------- */
    let autoplay;
    if (swiperEl.getAttribute("swiper-autoplay") === "true") {
      autoplay = {
        delay: 4000,
        disableOnInteraction: false,
        pauseOnMouseEnter: true
      };
    }

    /* ---------- SLIDES ---------- */
    const desktopSlides = parseFloat(swiperEl.getAttribute('swiper-slides') || 1);
    const mobileAttr = swiperEl.getAttribute('swiper-slides-mobile');

    let tabletSlides = desktopSlides;
    let mobileSlides = mobileAttr ? parseFloat(mobileAttr) : desktopSlides;

    if (!mobileAttr && desktopSlides === 3) {
      tabletSlides = 2;
      mobileSlides = 1;
    }

    const isMobilePeek = mobileAttr && parseFloat(mobileAttr) === 1.2;

    /* ---------- INIT ---------- */
    const swiper = new Swiper(swiperEl, {
      ...GLOBAL_CONFIG,
      ...(isDesktopPeek && { loop: true }),
      breakpoints: {
        0: {
          slidesPerView: mobileSlides,
          ...(isMobilePeek && { centeredSlides: true })
        },
        768: {
          slidesPerView: tabletSlides
        },
        992: {
          slidesPerView: isDesktopPeek ? 2 : desktopSlides,
          centeredSlides: isDesktopPeek ? true : false,
          spaceBetween: isDesktopPeek ? 32 : 20
        }
      },

      ...(navigation && { navigation }),
      ...(pagination && { pagination }),
      ...(autoplay && { autoplay }),

      on: {
        init(swiper) {
          toggleNavigation(swiper);
        },
        resize(swiper) {
          toggleNavigation(swiper);
        },
        breakpoint(swiper) {
          toggleNavigation(swiper);
        }
      }
    });

    function toggleNavigation(swiper) {
      if (!navigation) return;
      const totalSlides = swiper.slides.length;
      const visibleSlides = swiper.params.slidesPerView;
      if (totalSlides <= visibleSlides) {
        prevEl.style.display = "none";
        nextEl.style.display = "none";
      } else {
        prevEl.style.display = "";
        nextEl.style.display = "";
      }
    }
  }

  function destroySwiper(swiperEl) {
    if (!swiperEl.swiper) return;
    swiperEl.swiper.destroy(true, true);
    swiperEl.swiper = null;
  }

  function handleResponsiveSwipers() {
    document.querySelectorAll('[swiper="true"]').forEach((swiperEl) => {
      const disableDesktop = swiperEl.hasAttribute('swiper-disable-desktop');
      const isDesktop = window.innerWidth >= DESKTOP_BREAKPOINT;
      if (disableDesktop && isDesktop) {
        destroySwiper(swiperEl);
      } else {
        initSwiper(swiperEl);
      }
    });
  }

  handleResponsiveSwipers();

  let resizeTimeout;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(handleResponsiveSwipers, 150);
  });

});
</script>

<!-- Recording Webflow variation views to localStorage -->
<script>
wf.onVariationRecorded(function(data) {
  try {
    var label = data.optimizationName + ': ' + data.variationName;
    var existing = localStorage.getItem('wf_variations');
    if (existing && existing.indexOf(label) !== -1) return;
    localStorage.setItem('wf_variations', existing ? existing + ' | ' + label : label);
  } catch(e) {}
});
</script>

