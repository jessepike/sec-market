body.archive .site,
body.blog #page,
body.archive #page {
    min-height: auto !important;
    height: auto !important;
}
*/
/* Target all possible content containers
.site-content,
#content,
.content-area,
#primary,
.blog-container,
.posts-wrapper,
.archive-container,
[class*="blog"],
[class*="post"],
[class*="content"] {
    min-height: auto !important;
    height: auto !important;
    padding-bottom: 0 !important;
}
 */
/* Force visibility of all elements 
body.blog *,
body.archive * {
    visibility: visible !important;
    opacity: 1 !important;
}
*/
/* Remove any scroll-triggered animations
[data-aos],
[data-animate],
[data-scroll],
.animate-on-scroll,
.lazy-load {
    transform: none !important;
    transition: none !important;
    animation: none !important;
    opacity: 1 !important;
    visibility: visible !important;
}
 */
/* Ensure footer stays close to content 
.site-footer,
footer,
#footer,
[class*="footer"] {
    margin-top: 0 !important;
    padding-top: 50px !important;
}
*/
/* Remove excessive spacing after main content 
main,
#main,
.main-content {
    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
}
*/
/* ======================================== */

