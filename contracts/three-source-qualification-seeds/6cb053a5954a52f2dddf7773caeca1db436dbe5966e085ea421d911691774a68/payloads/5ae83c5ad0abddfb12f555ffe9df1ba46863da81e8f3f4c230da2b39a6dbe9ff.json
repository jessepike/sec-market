@keyframes glow-pulse {
  0%, 100% {
    box-shadow: 0 0 40px rgba(255,255,255,0.06), 0 0 18px rgba(255,255,255,0.04), 0 22px 45px -12px rgba(0,0,0,0.6);
  }
  50% {
    box-shadow: 0 0 65px rgba(255,255,255,0.11), 0 0 28px rgba(255,255,255,0.06), 0 22px 45px -12px rgba(0,0,0,0.6);
  }
}
.mega-panel {
  /* Mounted closed menus must not keep invalidating paint for their glow. */
  animation-play-state: paused;
  visibility: hidden;
  opacity: 0;
  /* Closed panels stay mounted overlapping the header row; a closing panel would
     intercept hover over logo/CTA/gaps and fire onMouseEnter. pointer-events:none
     makes closed panels click/hover-through; restored to auto only when open. */
  pointer-events: none;
  transform: translateX(-50%) translateY(8px) scale(0.98);
  transition: opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1),
    transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
    visibility 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}
/* Reveal on :hover OR :focus-within (Tab into the item reveals synchronously,
   adding links to the tab order). Closed panels are pointer-events:none so stray
   hovers over header gaps/logo/CTA/cube pass through. */
.nav-menu-item:hover > .mega-panel,
.nav-menu-item:focus-within > .mega-panel {
  animation-play-state: running;
  visibility: visible;
  opacity: 1;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0) scale(1);
}
/* Close-on-navigation: a clicked link keeps focus/hover across a soft route
   change, holding the panel open on the new page. use-header-state flags the
   header to force every panel hidden (lifted on next hover/focus); !important
   beats the reveal above. */
header[data-suppress-menu] .mega-panel {
  animation-play-state: paused !important;
  visibility: hidden !important;
  opacity: 0 !important;
  pointer-events: none !important;
}
/* Click-to-close: clicking an open trigger force-hides ITS panel only, even
   while the pointer still hovers it (hover/focus-within would otherwise keep it
   open). Scoped to the one clicked item; cleared when the pointer/focus leaves
   (use-header-state). !important beats the reveal above. */
.nav-menu-item[data-pinned-closed] > .mega-panel {
  animation-play-state: paused !important;
  visibility: hidden !important;
  opacity: 0 !important;
  pointer-events: none !important;
}
/* Match the trigger to the click-closed panel: the pointer still hovers it, so
   group-hover would otherwise keep the lime pill + chevron flipped up while the
   panel is gone. Reset to the resting (closed) appearance. */
.nav-menu-item[data-pinned-closed] button[aria-haspopup] {
  background-color: transparent !important;
  color: color-mix(in oklab, var(--color-bone-01) 90%, transparent) !important;
}
.nav-menu-item[data-pinned-closed] button[aria-haspopup] svg {
  rotate: 0deg !important;
}
/* Hover bridge: the dead strip between trigger and fixed panel drops
   :hover and closes it mid-cross. Invisible strip below each trigger keeps
   :hover alive — under the trigger only, not header gaps/cube.
   Panel sits at header bottom (64px); 16px bridge clears that gap without
   bleeding onto a sticky section sub-nav the way 20px did. */
.nav-menu-item::after {
  content: "";
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  height: 16px;
}
